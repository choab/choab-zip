[Desktop Entry]
Type=Application
Name=CHOAB Zip
GenericName=Archive Manager
Comment=Native 7-Zip-style archiver for Linux, written in pure Rust
Exec=choab-zip %F
Icon=choab-zip
Terminal=false
Categories=Utility;Archiving;FileTools;
MimeType=application/x-7z-compressed;application/zip;application/x-tar;application/gzip;application/x-xz;application/x-bzip2;application/zstd;application/x-rar-compressed;
Keywords=archive;7z;zip;tar;compress;extract;
StartupNotify=true
StartupWMClass=choab-zip
